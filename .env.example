################################################
# Application
################################################
NODE_ENV=production

################################################
# Server
################################################
PORT=5000
REQUEST_BODY_LIMIT=1mb
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000

################################################
# Database
################################################
MONGODB_URI=mongodb://localhost:27017/hm_backend
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

################################################
# JWT
################################################
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_PRODUCTION_SECRET
JWT_EXPIRE=7d

################################################
# Google Login
################################################
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

################################################
# Author Dashboard Access
################################################
# true  = paid Author Dashboard entitlement required (backward-safe default when missing)
# false = approved authors get dashboard access automatically; new dashboard purchases are blocked
AUTHOR_DASHBOARD_PAID_ACCESS_ENABLED=true

################################################
# QR Payment
################################################
MERCHANT_UPI_ID=merchant@upi
MERCHANT_NAME=Harglim Publishers
MERCHANT_CODE=
PAYMENT_CURRENCY=INR
PAYMENT_EXPIRY_DURATION=24h
QR_EXPIRY_MINUTES=15

################################################
# Email
################################################
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

################################################
# Cloudinary
################################################
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_BYTES=26214400
CLOUDINARY_TIMEOUT_MS=60000

################################################
# Logging
################################################
LOG_TO_FILE=true

################################################
# Testing
################################################
MONGOMS_DOWNLOAD_DIR=node_modules/.cache/mongodb-binaries
